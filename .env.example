# ============================================================================
# UNA Chat — Variables de Entorno de Ejemplo (Laboratorio 8: Auth0 Social Auth)
# ============================================================================
# Copia este archivo a `.env` para desarrollo local:
#   cp .env.example .env
#
# IMPORTANTE:
# - NUNCA subas el archivo `.env` al repositorio Git.
# - En una Single Page Application (SPA) con React/Vite NUNCA debes usar ni
#   exponer un `AUTH0_CLIENT_SECRET`. Solo se utilizan el Domain y el Client ID.
# ============================================================================

# Dominio de tu tenant en Auth0 (sin https:// al inicio o con él, el SDK acepta el host)
# Ejemplo: dev-abc123xyz.us.auth0.com
VITE_AUTH0_DOMAIN=tu-tenant.us.auth0.com

# Client ID público de la aplicación tipo "Single Page Application" en Auth0
VITE_AUTH0_CLIENT_ID=tu_client_id_publico_de_auth0

# (Opcional) URL de redirección (Callback URL). Si se omite, usa window.location.origin
# Local: http://localhost:5173
# Vercel: https://una-chat.vercel.app
VITE_AUTH0_CALLBACK_URL=http://localhost:5173

# (Opcional) Audience de la API si se protege el backend NestJS con JWT
VITE_AUTH0_AUDIENCE=

